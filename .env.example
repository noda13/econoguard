# Backend
DATABASE_URL="file:./dev.db"
PORT=8901
NODE_ENV=development
TZ=Asia/Tokyo

# LLM providers (at least one required for summarization/risk assessment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Data sources
NEWSAPI_KEY=
FRED_API_KEY=
OPENEXCHANGERATES_APP_ID=

# Required when NODE_ENV=production
ADMIN_SECRET=
# Comma-separated list of allowed origins, e.g. https://example.com,https://app.example.com
ALLOWED_ORIGINS=

# Static collection (scripts/collect-static.ts / GitHub Actions), all optional
# GEMINI_API_KEY above is also read by the collection script
# Groq API key (LLM provider)
GROQ_API_KEY=
# OpenAI API key (LLM provider)
OPENAI_API_KEY=
# Force a provider: groq, gemini or openai (auto-detected from the available keys when empty)
LLM_PROVIDER=
# Override the provider's API endpoint
LLM_BASE_URL=
# Override the provider's model
LLM_MODEL=
# Override the API key; together with LLM_BASE_URL it selects a custom endpoint
LLM_API_KEY=
